# --- Algemeen -------------------------------------------------------------
# Publieke basis-URL (zonder slash aan het eind). Gebruikt voor canonicals, sitemap en OG.
NEXT_PUBLIC_SITE_URL=https://www.yorsocials.nl

# 'staging' toont demo-/voorbeeldcontent met zichtbare demolabels en zet alle pagina's op noindex.
# 'production' verbergt alles met status demo/draft. Zet pas op production na akkoord opdrachtgever.
NEXT_PUBLIC_CONTENT_MODE=staging

# --- CMS (Link & Lead) -----------------------------------------------------
# Read-token voor https://linkandlead.nl/api/cms/content. Alleen server-side; nooit NEXT_PUBLIC_.
# Leeg = de site toont de ingebouwde inhoud uit src/content/data.
CMS_TOKEN=
# Basis-URL van het CMS (standaard https://linkandlead.nl).
CMS_URL=
# Geheim voor de publish-webhook (POST /api/revalidate, header x-ll-signature). Leeg = webhook uit.
CMS_WEBHOOK_SECRET=
# Formulierinzendingen gaan naar de CMS-leads (site-ID in siteSettings). Zet op 1 om dat uit te zetten (tests).
CMS_LEADS_DISABLED=

# --- Contactformulier (server-side) ---------------------------------------
# Kies één bestemming. Zonder bestemming geeft het formulier een eerlijke foutmelding (503),
# nooit een nep-succes.
# Optie A: webhook naar CRM/automation (ontvangt JSON, verwacht 2xx).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# Optie B: e-mail via Resend (https://resend.com). Afzenderdomein moet geverifieerd zijn.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Analytics (cookieloos) -----------------------------------------------
# Domein zoals ingesteld in Plausible, bijv. yorsocials.nl. Leeg = geen analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
